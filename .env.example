# 이 파일을 복사해 .env 를 만들고 실제 값을 넣으세요. (.env 는 커밋 금지)
# Supabase 대시보드 > Settings > API Keys > "Publishable and secret API keys" 탭

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# secret key(sb_secret_...) 는 여기에 넣지 마세요.
# RLS 를 우회하는 키라서, 브라우저로 내려가는 VITE_ 변수에 넣으면 그대로 노출됩니다.
